<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Voxel Sculptor - Per-Face Coloring</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: "Courier New", Courier, monospace;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            color: #fff;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
        }
        
        h1 {
            text-align: center;
            margin-bottom: 10px;
            font-size: 2.5em;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }
        
        .subtitle {
            text-align: center;
            margin-bottom: 30px;
            opacity: 0.9;
        }
        
        .canvas-grid {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
            background: rgba(255,255,255,0.1);
            padding: 40px;
            backdrop-filter: blur(10px);
        }
        
        .top-row {
            display: flex;
            justify-content: center;
        }
        
        .bottom-row {
            display: flex;
            gap: 20px;
        }
        
        .canvas-container {
            position: relative;
        }
        
        .canvas-container label {
            font-weight: bold;
            font-size: 1.1em;
            text-align: center;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            display: block;
            margin-bottom: 10px;
        }
        
        canvas {
            border: 3px solid #fff;
            background: white;
            cursor: crosshair;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        #canvasY {
            /* No transform needed */
        }
        
        #canvasZ {
            transform: rotate(180deg);
        }
        
        #canvasX {
            transform: rotate(270deg);
        }
                
        
        .controls {
            text-align: center;
            margin-bottom: 20px;
        }
        
        .controls button {
            padding: 12px 30px;
            margin: 0 10px;
            font-size: 16px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: 2px solid white;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }
        
        .controls button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        }
        
        .color-palette {
            display: inline-flex;
            gap: 20px;
            margin: 0 20px;
            flex-wrap: wrap;
            max-width: 600px;
            justify-content: center;
        }
        
        .color-swatch {
            width: 40px;
            height: 40px;
            border: 0px solid white;
            border-radius: 2px;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 2px 2px 5px black;
        }
        
        .color-swatch:hover {
            border-width: 0px;
            transform: scale(1.1);
        }
        
        .color-swatch.selected {
            border-width: 0px;
            /*box-shadow: 0 0 15px rgba(255, 255, 255, 0.8);*/
            transform: scale(1.4);
        }
        
        #renderer {
            width: 100%;
            height: 600px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0,0,0,0.4);
        }
        
        .message {
            text-align: center;
            padding: 15px;
            margin: 20px auto;
            max-width: 600px;
            border-radius: 10px;
            font-weight: bold;
        }
        
        .error {
            background: rgba(255, 50, 50, 0.8);
        }
        
        .success {
            background: rgba(50, 255, 50, 0.8);
        }
        
        .info {
            background: rgba(255, 255, 255, 0.2);
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>3D Voxel Sculptor</h1>
        <p class="subtitle">Draw silhouettes to carve out a 3D model with colored faces!</p>
        
        <div class="message info">
            Each face of the voxels will be colored based on the view you draw on!
        </div>
        
        <div class="canvas-grid">
            <div class="top-row">
                <div class="canvas-container top-face">
                    <label>Top View (Y-axis, looking down)</label>
                    <canvas id="canvasY" width="320" height="320"></canvas>
                </div>
            </div>
            <div class="bottom-row">
                <div class="canvas-container left-face">
                    <label>Front View (Z-axis, looking forward)</label>
                    <canvas id="canvasZ" width="320" height="320"></canvas>
                </div>
                <div class="canvas-container right-face">
                    <label>Side View (X-axis, looking right)</label>
                    <canvas id="canvasX" width="320" height="320"></canvas>
                </div>
            </div>
        </div>
        
        <div class="controls">
            <div id="colorPalette" class="color-palette"></div>
            <button onclick="clearAll()">Clear All</button>
            <button onclick="generateVoxelModel()">Generate 3D Model</button>
            <button onclick="createCube()">Load Cube</button>
        </div>
        
        <div id="message"></div>
        
        <div id="renderer"></div>
    </div>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        const VOXEL_SIZE = 8;
        const CANVAS_SIZE = 320;
        const PIXEL_SIZE = CANVAS_SIZE / VOXEL_SIZE;
        
        const PALETTE = [
            '#3a3b3e',
            '#ad4359',
            '#e35c4d',
            '#ffab68',
            '#ffe866',
            '#ffffff',
            '#ffb5c8',
            '#ff6d9d',
            '#b65a96',
            '#6d4d8d',
            '#4a6a97',
            '#9acbe4',
            '#d9ff85',
            '#57e0a4',
            '#4aa5b5',
            '#3a4b73'
        ];
        
        const canvases = {
            x: document.getElementById('canvasX'),
            y: document.getElementById('canvasY'),
            z: document.getElementById('canvasZ')
        };
        
        const contexts = {};
        const grids = {};
        let isDrawing = false;
        let currentColor = PALETTE[5]; // Start with white
        
        // Initialize canvases
        Object.keys(canvases).forEach(key => {
            const canvas = canvases[key];
            const ctx = canvas.getContext('2d');
            contexts[key] = ctx;
            
            // Initialize grid (all white)
            grids[key] = Array(VOXEL_SIZE).fill().map(() => 
                Array(VOXEL_SIZE).fill('#ffffff')
            );
            
            ctx.imageSmoothingEnabled = false;
            drawGrid(key);
            
            canvas.addEventListener('mousedown', (e) => {
                isDrawing = true;
                paintPixel(key, e, canvas);
            });
            
            canvas.addEventListener('mousemove', (e) => {
                if (isDrawing) paintPixel(key, e, canvas);
            });
            
            canvas.addEventListener('mouseup', () => isDrawing = false);
            canvas.addEventListener('mouseleave', () => isDrawing = false);
        });
        
        // Initialize color palette
        function initColorPalette() {
            const paletteDiv = document.getElementById('colorPalette');
            PALETTE.forEach((color, index) => {
                const swatch = document.createElement('div');
                swatch.className = 'color-swatch';
                swatch.style.backgroundColor = color;
                if (color === currentColor) {
                    swatch.classList.add('selected');
                }
                swatch.addEventListener('click', () => {
                    currentColor = color;
                    document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
                    swatch.classList.add('selected');
                });
                paletteDiv.appendChild(swatch);
            });
        }
        
        initColorPalette();
        
        function drawGrid(canvasKey) {
            const ctx = contexts[canvasKey];
            const grid = grids[canvasKey];
            
            for (let i = 0; i < VOXEL_SIZE; i++) {
                for (let j = 0; j < VOXEL_SIZE; j++) {
                    ctx.fillStyle = grid[i][j];
                    ctx.fillRect(i * PIXEL_SIZE, j * PIXEL_SIZE, PIXEL_SIZE, PIXEL_SIZE);
                }
            }
            
            ctx.strokeStyle = '#cccccc';
            ctx.lineWidth = 1;
            for (let i = 0; i <= VOXEL_SIZE; i++) {
                ctx.beginPath();
                ctx.moveTo(i * PIXEL_SIZE, 0);
                ctx.lineTo(i * PIXEL_SIZE, CANVAS_SIZE);
                ctx.stroke();
                
                ctx.beginPath();
                ctx.moveTo(0, i * PIXEL_SIZE);
                ctx.lineTo(CANVAS_SIZE, i * PIXEL_SIZE);
                ctx.stroke();
            }
        }
        
        function paintPixel(canvasKey, e, canvas) {
            const rect = canvas.getBoundingClientRect();
            let mouseX;
            let mouseY;

            if (canvasKey == "x") {
                mouseX = CANVAS_SIZE - (e.clientY - rect.top);
                mouseY = e.clientX - rect.left;
            } else if (canvasKey == "y") {
                mouseX = e.clientX - rect.left;
                mouseY = e.clientY - rect.top;
            } else {
                mouseX = CANVAS_SIZE - (e.clientX - rect.left);
                mouseY = CANVAS_SIZE - (e.clientY - rect.top);
            }
            
            const gridX = Math.floor(mouseX / PIXEL_SIZE);
            const gridY = Math.floor(mouseY / PIXEL_SIZE);
            
            if (gridX >= 0 && gridX < VOXEL_SIZE && gridY >= 0 && gridY < VOXEL_SIZE) {
                grids[canvasKey][gridX][gridY] = currentColor;
                drawGrid(canvasKey);
            }
        }
        
        function clearAll() {
            Object.keys(grids).forEach(key => {
                grids[key] = Array(VOXEL_SIZE).fill().map(() => 
                    Array(VOXEL_SIZE).fill('#ffffff')
                );
                drawGrid(key);
            });
            showMessage('All canvases cleared!', 'info');
        }

        function drawRectangle(dimension, start_i, end_i, start_j, end_j, color) {
            for (let i = start_i; i < end_i; i++) {
                for (let j = start_j; j < end_j; j++) {
                    grids[dimension][i][j] = color;
                }
            }
        }
        
        function createCube() {
            clearAll();

            drawRectangle('x', 2, VOXEL_SIZE - 2 , 2, VOXEL_SIZE - 2, '#4aa5b5');
            drawRectangle('y', 2, VOXEL_SIZE - 2, 2, VOXEL_SIZE - 2, '#e35c4d');
            drawRectangle('z', 2, VOXEL_SIZE - 2, 2, VOXEL_SIZE - 2, '#57e0a4');
            
            ['x', 'y', 'z'].forEach(key => drawGrid(key));
            
            showMessage('Demo loaded! You should see a cube with different colored faces.', 'success');
        }

        function createTree() {
            clearAll();

            drawRectangle('x', )
        }
        
        function isColorSolid(color) {
            return color !== '#ffffff';
        }
        
        function hexToRgb(hex) {
            const r = parseInt(hex.substr(1, 2), 16);
            const g = parseInt(hex.substr(3, 2), 16);
            const b = parseInt(hex.substr(5, 2), 16);
            return [r, g, b];
        }
        
        function generateVoxelModel() {
            // STEP 1: Start with all voxels as solid
            const voxelSpace = Array(VOXEL_SIZE).fill().map(() =>
                Array(VOXEL_SIZE).fill().map(() =>
                    Array(VOXEL_SIZE).fill(true)
                )
            );
            
            // STEP 2: CARVE using each view's silhouette
            
            // Carve from TOP view (Y-axis)
            for (let canvasX = 0; canvasX < VOXEL_SIZE; canvasX++) {
                for (let canvasZ = 0; canvasZ < VOXEL_SIZE; canvasZ++) {
                    const color = grids['y'][canvasX][canvasZ];
                    if (!isColorSolid(color)) {
                        for (let y = 0; y < VOXEL_SIZE; y++) {
                            voxelSpace[canvasX][y][canvasZ] = false;
                        }
                    }
                }
            }
            
            // Carve from FRONT view (Z-axis)
            for (let canvasX = 0; canvasX < VOXEL_SIZE; canvasX++) {
                for (let canvasY = 0; canvasY < VOXEL_SIZE; canvasY++) {
                    const color = grids['z'][canvasX][canvasY];
                    if (!isColorSolid(color)) {
                        for (let z = 0; z < VOXEL_SIZE; z++) {
                            voxelSpace[canvasX][canvasY][z] = false;
                        }
                    }
                }
            }
            
            // Carve from SIDE view (X-axis)
            for (let canvasY = 0; canvasY < VOXEL_SIZE; canvasY++) {
                for (let canvasZ = 0; canvasZ < VOXEL_SIZE; canvasZ++) {
                    const color = grids['x'][canvasY][canvasZ];
                    if (!isColorSolid(color)) {
                        for (let x = 0; x < VOXEL_SIZE; x++) {
                            voxelSpace[x][canvasY][canvasZ] = false;
                        }
                    }
                }
            }
            
            // STEP 3: Store voxels with 6 face colors
            const voxels = [];
            
            for (let x = 0; x < VOXEL_SIZE; x++) {
                for (let y = 0; y < VOXEL_SIZE; y++) {
                    for (let z = 0; z < VOXEL_SIZE; z++) {
                        if (voxelSpace[x][y][z]) {
                            // Get colors from each view for the 6 faces
                            const topColor = grids['y'][x][z];        // Top face (Y+)
                            const bottomColor = grids['y'][x][z];     // Bottom face (Y-)
                            const frontColor = grids['z'][x][y];      // Front face (Z+)
                            const backColor = grids['z'][x][y];       // Back face (Z-)
                            const rightColor = grids['x'][y][z];      // Right face (X+)
                            const leftColor = grids['x'][y][z];       // Left face (X-)
                            
                            voxels.push({
                                x, y, z,
                                faces: {
                                    top: hexToRgb(topColor),
                                    bottom: hexToRgb(bottomColor),
                                    front: hexToRgb(frontColor),
                                    back: hexToRgb(backColor),
                                    right: hexToRgb(rightColor),
                                    left: hexToRgb(leftColor)
                                }
                            });
                        }
                    }
                }
            }
            
            if (voxels.length === 0) {
                showMessage('No voxels generated! Draw on all three views to create a shape.', 'error');
                return;
            }
            
            showMessage(`Success! Generated ${voxels.length} voxels with per-face coloring.`, 'success');
            renderVoxelModel(voxels);
        }
        
        function showMessage(text, type) {
            const msgDiv = document.getElementById('message');
            msgDiv.textContent = text;
            msgDiv.className = `message ${type}`;
            msgDiv.style.display = 'block';
        }
        
        // Three.js rendering
        let scene, camera, renderer, voxelGroup;
        
        function initThreeJS() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x1a1a2e);
            
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / 600, 0.1, 1000);
            camera.position.set(25 * VOXEL_SIZE / 8, 25 * VOXEL_SIZE / 8, 25 * VOXEL_SIZE / 8);
            camera.lookAt(0, 0, 0);
            
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, 600);
            document.getElementById('renderer').appendChild(renderer.domElement);
            
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);
            
            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(10, 10, 10);
            scene.add(directionalLight);
            
            animate();
        }
        
        function renderVoxelModel(voxels) {
            if (voxelGroup) scene.remove(voxelGroup);
            
            voxelGroup = new THREE.Group();
            
            voxels.forEach(voxel => {
                // Create a cube with different materials for each face
                const materials = [
                    new THREE.MeshLambertMaterial({ color: new THREE.Color(`rgb(${voxel.faces.right[0]}, ${voxel.faces.right[1]}, ${voxel.faces.right[2]})`) }),  // right (X+)
                    new THREE.MeshLambertMaterial({ color: new THREE.Color(`rgb(${voxel.faces.left[0]}, ${voxel.faces.left[1]}, ${voxel.faces.left[2]})`) }),    // left (X-)
                    new THREE.MeshLambertMaterial({ color: new THREE.Color(`rgb(${voxel.faces.top[0]}, ${voxel.faces.top[1]}, ${voxel.faces.top[2]})`) }),      // top (Y+)
                    new THREE.MeshLambertMaterial({ color: new THREE.Color(`rgb(${voxel.faces.bottom[0]}, ${voxel.faces.bottom[1]}, ${voxel.faces.bottom[2]})`) }), // bottom (Y-)
                    new THREE.MeshLambertMaterial({ color: new THREE.Color(`rgb(${voxel.faces.front[0]}, ${voxel.faces.front[1]}, ${voxel.faces.front[2]})`) }),  // front (Z+)
                    new THREE.MeshLambertMaterial({ color: new THREE.Color(`rgb(${voxel.faces.back[0]}, ${voxel.faces.back[1]}, ${voxel.faces.back[2]})`) })     // back (Z-)
                ];
                
                const geometry = new THREE.BoxGeometry(2, 2, 2);
                const cube = new THREE.Mesh(geometry, materials);
                
                cube.position.set(
                    (voxel.x - VOXEL_SIZE / 2) * 2,
                    (voxel.y - VOXEL_SIZE / 2) * 2,
                    (voxel.z - VOXEL_SIZE / 2) * 2
                );
                
                voxelGroup.add(cube);
            });
            
            scene.add(voxelGroup);
        }
        
        function animate() {
            requestAnimationFrame(animate);
            
            if (voxelGroup) {
                voxelGroup.rotation.y += 0.005;
            }
            
            renderer.render(scene, camera);
        }
        
        window.addEventListener('resize', () => {
            if (renderer) {
                camera.aspect = window.innerWidth / 600;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, 600);
            }
        });
        
        initThreeJS();
    </script>
</body>
</html>
